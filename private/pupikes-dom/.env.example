# Продукция (Postgres). Ако е празно → локален SQLite файл (data/pupikes-dom.sqlite).
DATABASE_URL=postgres://user:pass@host:5432/pupikesdom
# Тайна за JWT токени (задай дълъг случаен низ в продукция)
JWT_SECRET=smeni-me-v-produkciya
# Порт на сървъра
PORT=8080
# (по избор) FCM ключ за истински push към телефони — попълва се когато има Google проект
FCM_SERVER_KEY=
