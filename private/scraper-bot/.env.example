# Копирай като .env (стои ЛОКАЛНО, никога в git/сървър публично).
# ── SMTP за изпращане на писма (вариант 3 „изпращане") ──
scraper_email_user=твой@gmail.com
scraper_email_pass=app-парола-от-google
scraper_smtp_server=smtp.gmail.com
scraper_smtp_port=587
scraper_delay_minutes=20
scraper_max_per_run=25

# ── Общи ──
scraper_max_items=100
scraper_api_port=3030
# Ако е зададен — API-то иска Authorization: Bearer <token> (препоръчително).
scraper_api_token=
