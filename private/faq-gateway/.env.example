# faq-gateway .env — копирай като .env и попълни само каналите, които ползваш.
# Всеки канал е опционален: без ключове просто е изключен.

PORT=8092

# Админ токен — приложението го праща при публикуване на базата (/kb) и при четене на /log.
# Сложи дълъг случаен низ. Без него админ операциите са забранени.
ADMIN_TOKEN=

# ── WhatsApp Cloud API (Meta) — БЕЗПЛАТНО за тест ──
# developers.facebook.com → App → WhatsApp → API Setup: вземи Token + Phone number ID.
# WA_VERIFY_TOKEN е низ, който ти сам избираш и въвеждаш и в конзолата при webhook-а.
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=pupikes-verify

# ── Facebook Messenger — БЕЗПЛАТНО ──
# App → Messenger → Page access token за твоята страница.
MSGR_PAGE_TOKEN=
MSGR_VERIFY_TOKEN=pupikes-verify

# ── Viber Bot — БЕЗПЛАТНО ──
# partners.viber.com → създай Public Account/Bot → вземи Auth token.
VIBER_TOKEN=
VIBER_BOT_NAME=Pupikes FAQ
VIBER_AVATAR=
